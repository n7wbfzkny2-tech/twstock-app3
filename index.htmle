<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TWSTOCK Analytics</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react/18.2.0/umd/react.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/react-dom/18.2.0/umd/react-dom.production.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.5/babel.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:#0a0c0f;color:#e8edf5;font-family:'IBM Plex Mono',monospace;}
  ::-webkit-scrollbar{width:4px;height:4px;}
  ::-webkit-scrollbar-track{background:#0f1318;}
  ::-webkit-scrollbar-thumb{background:#1e2d3d;border-radius:2px;}
  @keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes pulse{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1)}}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .row-hover:hover{background:#1c2330!important;cursor:pointer;}
  input::placeholder{color:#4a6080;}
  .btn-nav:hover{color:#e8edf5!important;}
</style>
</head>
<body>
<div id="root"></div>
<script type="text/babel">

// ★ 填入你的設定 ★
const PROXY_BASE_URL = "https://twstock-proxy-psi.vercel.app/api/proxy";
const FUGLE_TOKEN    = "MTY4MDk1NGMtMWJhNS00OGZjLWEwYjEtNmE2ZTIxOWY1ZjA4IGNjNjJmNjI0LWE4ZmItNDgwNy1iMTgxLTUzZWEyNzdmNDZmZg==";
const CLAUDE_MODEL   = "claude-sonnet-4-20250514";

const C = {
  bg0:"#0a0c0f",bg1:"#0f1318",bg2:"#141921",bg3:"#1c2330",
  border:"#1e2d3d",
  accent:"#f0a500",accentDim:"#f0a50022",
  green:"#00d084",greenDim:"#00d08422",
  red:"#ff3d57",redDim:"#ff3d5722",
  blue:"#2196f3",blueDim:"#2196f322",
  purple:"#9c6eff",purpleDim:"#9c6eff22",
  orange:"#ff7043",
  text0:"#e8edf5",text1:"#8fa3b8",text2:"#4a6080",
};

const DEFAULT_WATCHLIST = [
  {code:"2330",name:"台積電",theme:"AI晶片"},
  {code:"6669",name:"緯穎",theme:"AI伺服器"},
  {code:"3711",name:"日月光投控",theme:"CoWoS封裝"},
  {code:"2454",name:"聯發科",theme:"AI晶片"},
  {code:"2634",name:"漢翔",theme:"軍工航太"},
  {code:"6282",name:"康舒",theme:"儲能電池"},
];

const HOT_THEMES = [
  {name:"AI伺服器",stocks:["6669","2330","3711"]},
  {name:"CoWoS封裝",stocks:["2454","3034","6770"]},
  {name:"電動車",stocks:["2207","1590","6239"]},
  {name:"軍工航太",stocks:["1722","2634","2609"]},
  {name:"散熱模組",stocks:["3443","6230","8383"]},
  {name:"儲能電池",stocks:["1513","6282","3691"]},
];

// ── API ────────────────────────────────────────────────────
async function fetchFugleKline(code) {
  try {
    const r = await fetch(
      `https://api.fugle.tw/marketdata/v1.0/stock/historical/candles?symbol=${code}&timeframe=D&limit=60`,
      {headers:{"X-API-KEY":FUGLE_TOKEN}}
    );
    const j = await r.json();
    return (j.data||[]).map(d=>({
      date:new Date(d.date),open:d.open,high:d.high,low:d.low,close:d.close,vol:d.volume
    })).reverse();
  } catch(e){return null;}
}

async function fetchFugleQuote(code) {
  try {
    const r = await fetch(
      `https://api.fugle.tw/marketdata/v1.0/stock/intraday/quote?symbol=${code}`,
      {headers:{"X-API-KEY":FUGLE_TOKEN}}
    );
    const j = await r.json();
    return {
      price:j.closePrice||j.lastPrice||0,
      change:j.change||0,
      changePct:j.changePercent||0,
      volume:j.volume||0,
      high:j.highPrice||0,
      low:j.lowPrice||0,
      open:j.openPrice||0,
    };
  } catch(e){return null;}
}

async function fetchInstitutional(code) {
  try {
    const r = await fetch(`${PROXY_BASE_URL}?type=institutional&stockCode=${code}`);
    return await r.json();
  } catch(e){return null;}
}

async function fetchMargin(code) {
  try {
    const r = await fetch(`${PROXY_BASE_URL}?type=margin&stockCode=${code}`);
    return await r.json();
  } catch(e){return null;}
}

// ── Hooks ──────────────────────────────────────────────────
function useStockData(code) {
  const [quote,setQuote]         = React.useState(null);
  const [kline,setKline]         = React.useState(null);
  const [inst,setInst]           = React.useState(null);
  const [margin,setMargin]       = React.useState(null);
  const [loading,setLoading]     = React.useState(true);

  const load = React.useCallback(async()=>{
    setLoading(true);
    const [q,k,i,m] = await Promise.all([
      fetchFugleQuote(code),
      fetchFugleKline(code),
      fetchInstitutional(code),
      fetchMargin(code),
    ]);
    if(q) setQuote(q);
    if(k) setKline(k);
    if(i) setInst(i);
    if(m) setMargin(m);
    setLoading(false);
  },[code]);

  React.useEffect(()=>{load();},[load]);

  React.useEffect(()=>{
    const t = setInterval(async()=>{
      const q = await fetchFugleQuote(code);
      if(q) setQuote(q);
    },30000);
    return ()=>clearInterval(t);
  },[code]);

  return {quote,kline,inst,margin,loading,reload:load};
}

// ── KlineChart ─────────────────────────────────────────────
function KlineChart({data}){
  const ref = React.useRef(null);
  React.useEffect(()=>{
    if(!data||!data.length) return;
    const canvas=ref.current; if(!canvas) return;
    const ctx=canvas.getContext("2d");
    const W=canvas.width,H=canvas.height;
    const pL=10,pR=58,pT=24,pB=50;
    const cW=W-pL-pR,cH=(H-pT-pB)*0.65,vH=(H-pT-pB)*0.25;
    ctx.clearRect(0,0,W,H); ctx.fillStyle=C.bg1; ctx.fillRect(0,0,W,H);
    const prices=data.flatMap(d=>[d.high,d.low]);
    const minP=Math.min(...prices)*0.997,maxP=Math.max(...prices)*1.003;
    const maxV=Math.max(...data.map(d=>d.vol));
    const xS=i=>pL+(i/(data.length-1))*cW;
    const yS=p=>pT+cH-((p-minP)/(maxP-minP))*cH;
    const vS=v=>H-pB-(v/maxV)*vH;
    ctx.strokeStyle=C.border; ctx.lineWidth=0.5;
    for(let i=0;i<=4;i++){
      const y=pT+(i/4)*cH;
      ctx.beginPath();ctx.moveTo(pL,y);ctx.lineTo(W-pR,y);ctx.stroke();
      const val=maxP-(i/4)*(maxP-minP);
      ctx.fillStyle=C.text2;ctx.font="10px IBM Plex Mono";ctx.textAlign="left";
      ctx.fillText(val.toFixed(1),W-pR+4,y+3);
    }
    [[5,C.accent],[20,C.blue],[60,C.purple]].forEach(([period,col])=>{
      if(data.length<period) return;
      ctx.strokeStyle=col;ctx.lineWidth=1;ctx.globalAlpha=0.75;ctx.beginPath();
      for(let i=period-1;i<data.length;i++){
        const avg=data.slice(i-period+1,i+1).reduce((s,d)=>s+d.close,0)/period;
        if(i===period-1) ctx.moveTo(xS(i),yS(avg)); else ctx.lineTo(xS(i),yS(avg));
      }
      ctx.stroke();ctx.globalAlpha=1;
    });
    const bw=Math.max(2,cW/data.length-1.5);
    data.forEach((d,i)=>{
      const x=xS(i),isUp=d.close>=d.open;
      ctx.strokeStyle=isUp?C.green:C.red;ctx.fillStyle=isUp?C.green:C.red;ctx.lineWidth=1;
      ctx.beginPath();ctx.moveTo(x,yS(d.high));ctx.lineTo(x,yS(d.low));ctx.stroke();
      ctx.globalAlpha=isUp?0.85:0.75;
      ctx.fillRect(x-bw/2,yS(Math.max(d.open,d.close)),bw,Math.max(1,Math.abs(yS(d.open)-yS(d.close))));
      ctx.globalAlpha=1;
      ctx.fillStyle=isUp?C.green:C.red;ctx.globalAlpha=0.45;
      const top=vS(d.vol);ctx.fillRect(x-bw/2,top,bw,H-pB-top);ctx.globalAlpha=1;
    });
    [["MA5",C.accent],["MA20",C.blue],["MA60",C.purple]].forEach(([l,col],i)=>{
      ctx.fillStyle=col;ctx.font="10px IBM Plex Mono";ctx.textAlign="left";
      ctx.fillText(l,pL+i*56,pT-6);
    });
    const step=Math.ceil(data.length/6);
    ctx.fillStyle=C.text2;ctx.font="9px IBM Plex Mono";ctx.textAlign="center";
    data.forEach((d,i)=>{
      if(i%step===0) ctx.fillText(`${d.date.getMonth()+1}/${d.date.getDate()}`,xS(i),H-pB+14);
    });
  },[data]);
  return React.createElement("canvas",{ref,width:680,height:360,style:{width:"100%",height:"100%",display:"block"}});
}

// ── Spinner ────────────────────────────────────────────────
function Spinner(){
  return React.createElement("div",{style:{display:"flex",alignItems:"center",justifyContent:"center",height:180,gap:6}},
    [0,1,2].map(i=>React.createElement("div",{key:i,style:{width:8,height:8,borderRadius:"50%",background:C.accent,animation:`pulse 1.2s ${i*0.2}s ease-in-out infinite`}})),
    React.createElement("span",{style:{fontSize:12,color:C.text2,marginLeft:8}},"載入真實資料中...")
  );
}

// ── AIPanel ────────────────────────────────────────────────
function AIPanel({stock,quote,inst,margin,onClose}){
  const [msgs,setMsgs]   = React.useState([]);
  const [input,setInput] = React.useState("");
  const [loading,setLd]  = React.useState(false);
  const bottomRef        = React.useRef(null);

  const send = React.useCallback(async(text)=>{
    if(!text.trim()) return;
    const um={role:"user",content:text};
    const nm=[...msgs,um];
    setMsgs(nm);setInput("");setLd(true);
    const sys=`你是台灣股市頂尖分析師，繁體中文，精準有洞察力，每次150字內。
【真實資料】股票：${stock.code} ${stock.name}，主題：${stock.theme}
現價：${quote?.price??'N/A'}，漲跌：${quote?.changePct??'N/A'}%
外資今日：${inst?.foreign??'N/A'}張，投信：${inst?.invest??'N/A'}張
融資餘額：${margin?.marginBalance??'N/A'}張，融券：${margin?.shortBalance??'N/A'}張`;
    try{
      const r=await fetch("https://api.anthropic.com/v1/messages",{
        method:"POST",headers:{"Content-Type":"application/json"},
        body:JSON.stringify({model:CLAUDE_MODEL,max_tokens:1000,system:sys,messages:nm})
      });
      const d=await r.json();
      const reply=d.content?.find(b=>b.type==="text")?.text||"無法取得回應";
      setMsgs(prev=>[...prev,{role:"assistant",content:reply}]);
    }catch{setMsgs(prev=>[...prev,{role:"assistant",content:"⚠️ 連線錯誤"}]);}
    setLd(false);
  },[msgs,stock,quote,inst,margin]);

  React.useEffect(()=>{
    send(`請根據真實籌碼資料，分析 ${stock.name} 今日值不值得關注，說明關鍵理由。`);
  },[]);
  React.useEffect(()=>{bottomRef.current?.scrollIntoView({behavior:"smooth"});},[msgs,loading]);

  const quickQ=["外資意圖解讀","融券軋空機會?","短期壓力支撐","今日異常訊號"];

  return React.createElement("div",{style:{position:"fixed",inset:0,background:"#00000088",zIndex:100,display:"flex",alignItems:"center",justifyContent:"center",backdropFilter:"blur(4px)"}},
    React.createElement("div",{style:{width:"min(520px,95vw)",maxHeight:"80vh",background:C.bg1,border:`1px solid ${C.border}`,borderRadius:8,display:"flex",flexDirection:"column",overflow:"hidden",boxShadow:`0 0 60px ${C.accentDim},0 24px 48px #00000080`}},
      // header
      React.createElement("div",{style:{padding:"14px 20px",borderBottom:`1px solid ${C.border}`,display:"flex",justifyContent:"space-between",alignItems:"center"}},
        React.createElement("span",{style:{color:C.accent,fontSize:13,fontWeight:700}},`🤖 AI分析師（真實資料）· ${stock.code} ${stock.name}`),
        React.createElement("button",{onClick:onClose,style:{background:"none",border:"none",color:C.text2,cursor:"pointer",fontSize:18}},"✕")
      ),
      // messages
      React.createElement("div",{style:{flex:1,overflowY:"auto",padding:20,display:"flex",flexDirection:"column",gap:14}},
        msgs.map((m,i)=>React.createElement("div",{key:i,style:{display:"flex",justifyContent:m.role==="user"?"flex-end":"flex-start"}},
          React.createElement("div",{style:{maxWidth:"82%",padding:"10px 14px",borderRadius:8,fontSize:13,lineHeight:1.6,
            background:m.role==="user"?C.accentDim:C.bg3,border:`1px solid ${m.role==="user"?C.accent+"44":C.border}`,
            color:m.role==="user"?C.accent:C.text0,fontFamily:m.role==="assistant"?"'Noto Sans TC',sans-serif":"inherit"}},m.content)
        )),
        loading&&React.createElement("div",{style:{display:"flex",gap:4,padding:"10px 14px"}},
          [0,1,2].map(i=>React.createElement("div",{key:i,style:{width:6,height:6,borderRadius:"50%",background:C.accent,animation:`pulse 1.2s ${i*0.2}s ease-in-out infinite`}}))
        ),
        React.createElement("div",{ref:bottomRef})
      ),
      // quick q
      React.createElement("div",{style:{padding:"8px 20px",display:"flex",gap:8,flexWrap:"wrap",borderTop:`1px solid ${C.border}`}},
        quickQ.map((q,i)=>React.createElement("button",{key:i,onClick:()=>send(q),disabled:loading,
          style:{background:C.bg3,border:`1px solid ${C.border}`,borderRadius:4,color:C.text1,fontSize:11,padding:"4px 10px",cursor:"pointer",fontFamily:"inherit"}},q))
      ),
      // input
      React.createElement("div",{style:{padding:"12px 20px",borderTop:`1px solid ${C.border}`,display:"flex",gap:10}},
        React.createElement("input",{value:input,onChange:e=>setInput(e.target.value),onKeyDown:e=>e.key==="Enter"&&send(input),placeholder:"輸入問題...",
          style:{flex:1,background:C.bg3,border:`1px solid ${C.border}`,borderRadius:6,padding:"8px 12px",color:C.text0,fontSize:13,fontFamily:"IBM Plex Mono",outline:"none"}}),
        React.createElement("button",{onClick:()=>send(input),disabled:loading||!input.trim(),
          style:{background:C.accent,border:"none",borderRadius:6,padding:"8px 16px",color:"#000",fontWeight:700,fontSize:12,cursor:"pointer",opacity:loading?0.5:1}},"送出")
      )
    )
  );
}

// ── InstitutionalBar ───────────────────────────────────────
function IBar({label,value,color}){
  const abs=Math.abs(value||0),isPos=value>=0;
  return React.createElement("div",{style:{marginBottom:12}},
    React.createElement("div",{style:{display:"flex",justifyContent:"space-between",marginBottom:4}},
      React.createElement("span",{style:{fontSize:11,color:C.text2}},label),
      React.createElement("span",{style:{fontSize:13,fontWeight:700,color:isPos?C.green:C.red,fontFamily:"IBM Plex Mono"}},`${isPos?"+":""}${(value||0).toLocaleString()} 張`)
    ),
    React.createElement("div",{style:{background:C.bg3,borderRadius:3,height:6,overflow:"hidden"}},
      React.createElement("div",{style:{height:"100%",width:`${Math.min(100,(abs/10000)*100)}%`,background:isPos?`linear-gradient(90deg,${color},${color}88)`:C.red,borderRadius:3,transition:"width 0.6s"}})
    )
  );
}

// ── StockDetail ────────────────────────────────────────────
function StockDetail({stock}){
  const {quote,kline,inst,margin,loading,reload}=useStockData(stock.code);
  const [showAI,setShowAI]=React.useState(false);

  const card=(children,style={})=>React.createElement("div",{style:{background:C.bg1,border:`1px solid ${C.border}`,borderRadius:8,...style}},children);
  const sTitle=txt=>React.createElement("div",{style:{fontSize:11,color:C.text2,letterSpacing:"0.1em",marginBottom:16}},`▍ ${txt}`);
  const statCard=(label,value,color,sub)=>React.createElement("div",{style:{background:C.bg2,border:`1px solid ${C.border}`,borderRadius:8,padding:"14px 16px"}},
    React.createElement("div",{style:{fontSize:10,color:C.text2,marginBottom:6}},label),
    React.createElement("div",{style:{fontSize:18,fontWeight:700,color:color||C.text0,fontFamily:"IBM Plex Mono"}},value??"—"),
    sub&&React.createElement("div",{style:{fontSize:10,color:C.text1,marginTop:3}},sub)
  );

  return React.createElement("div",{style:{display:"flex",flexDirection:"column",gap:14,animation:"fadeIn 0.3s ease"}},
    // title row
    React.createElement("div",{style:{display:"flex",alignItems:"center",justifyContent:"space-between",flexWrap:"wrap",gap:10}},
      React.createElement("div",{style:{display:"flex",alignItems:"center",gap:12,flexWrap:"wrap"}},
        React.createElement("span",{style:{fontSize:18,fontWeight:700}},`${stock.code} ${stock.name}`),
        quote?React.createElement(React.Fragment,null,
          React.createElement("span",{style:{fontSize:22,fontWeight:700,fontFamily:"IBM Plex Mono"}},quote.price.toLocaleString()),
          React.createElement("span",{style:{fontSize:13,fontWeight:700,color:quote.changePct>=0?C.green:C.red}},`${quote.changePct>=0?"▲":"▼"}${Math.abs(quote.changePct).toFixed(2)}%`)
        ):loading&&React.createElement("span",{style:{fontSize:12,color:C.text2}},"載入中..."),
        React.createElement("span",{style:{background:C.blueDim,border:`1px solid ${C.blue}44`,borderRadius:4,padding:"3px 10px",color:C.blue,fontSize:11}},stock.theme)
      ),
      React.createElement("div",{style:{display:"flex",gap:8}},
        React.createElement("button",{onClick:reload,style:{background:C.bg3,border:`1px solid ${C.border}`,borderRadius:6,padding:"7px 14px",color:C.text1,fontSize:11,cursor:"pointer",fontFamily:"IBM Plex Mono"}},"↻ 更新"),
        React.createElement("button",{onClick:()=>setShowAI(true),style:{background:`linear-gradient(135deg,${C.accent},#ff6b35)`,border:"none",borderRadius:6,padding:"8px 18px",color:"#000",fontWeight:700,fontSize:11,cursor:"pointer",fontFamily:"IBM Plex Mono"}},"🤖 AI 分析（真實資料）")
      )
    ),
    // quote stats
    quote&&React.createElement("div",{style:{display:"grid",gridTemplateColumns:"repeat(4,1fr)",gap:12}},
      statCard("開盤",quote.open?.toLocaleString(),C.text0),
      statCard("最高",quote.high?.toLocaleString(),C.green),
      statCard("最低",quote.low?.toLocaleString(),C.red),
      statCard("成交量",`${(quote.volume/1000).toFixed(1)}K張`,C.text0)
    ),
    // kline
    card(React.createElement(React.Fragment,null,
      React.createElement("div",{style:{padding:"12px 20px",borderBottom:`1px solid ${C.border}`,fontSize:11,color:C.text2}},
        "▍ 日K線 · MA5 ● MA20 ● MA60 ●"
      ),
      React.createElement("div",{style:{height:360}},
        loading?React.createElement(Spinner):
        kline?React.createElement(KlineChart,{data:kline}):
        React.createElement("div",{style:{display:"flex",alignItems:"center",justifyContent:"center",height:"100%",color:C.text2,fontSize:12}},"無K線資料（請確認 Fugle Token）")
      )
    )),
    // inst + margin
    React.createElement("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:14}},
      card(React.createElement("div",{style:{padding:20}},
        sTitle("三大法人今日買賣超"),
        loading?React.createElement(Spinner):
        inst&&!inst.error?React.createElement(React.Fragment,null,
          React.createElement(IBar,{label:"外資",value:inst.foreign,color:C.green}),
          React.createElement(IBar,{label:"投信",value:inst.invest,color:C.blue}),
          React.createElement(IBar,{label:"自營商",value:inst.dealer,color:C.purple}),
          React.createElement("div",{style:{marginTop:14,paddingTop:14,borderTop:`1px solid ${C.border}`,display:"flex",justifyContent:"space-between"}},
            React.createElement("span",{style:{fontSize:12,color:C.text2}},"三大合計"),
            React.createElement("span",{style:{fontSize:14,fontWeight:700,color:inst.total>=0?C.green:C.red,fontFamily:"IBM Plex Mono"}},`${inst.total>=0?"+":""}${inst.total?.toLocaleString()} 張`)
          )
        ):React.createElement("div",{style:{fontSize:12,color:C.text2}},"無資料（非交易日或盤中更新中）")
      )),
      card(React.createElement("div",{style:{padding:20}},
        sTitle("融資融券"),
        loading?React.createElement(Spinner):
        margin&&!margin.error?React.createElement(React.Fragment,null,
          React.createElement("div",{style:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:14}},
            statCard("融資餘額",`${margin.marginBalance?.toLocaleString()}張`,C.blue,`買進 ${margin.marginBuy?.toLocaleString()}`),
            statCard("融券餘額",`${margin.shortBalance?.toLocaleString()}張`,C.orange,`賣出 ${margin.shortSell?.toLocaleString()}`)
          ),
          (()=>{
            const ratio=(margin.marginBalance/(margin.marginBalance+margin.shortBalance)*100).toFixed(1);
            return React.createElement("div",null,
              React.createElement("div",{style:{display:"flex",justifyContent:"space-between",marginBottom:5}},
                React.createElement("span",{style:{fontSize:11,color:C.text2}},"融資比率"),
                React.createElement("span",{style:{fontSize:11,fontWeight:700,color:+ratio>70?C.red:C.text0,fontFamily:"IBM Plex Mono"}},`${ratio}%`)
              ),
              React.createElement("div",{style:{background:C.bg3,borderRadius:4,height:7,overflow:"hidden"}},
                React.createElement("div",{style:{height:"100%",width:`${ratio}%`,background:+ratio>70?`linear-gradient(90deg,${C.orange},${C.red})`:`linear-gradient(90deg,${C.blue},${C.green})`,borderRadius:4}})
              ),
              React.createElement("div",{style:{fontSize:9,color:C.text2,marginTop:4}},">70% 融資過熱警示")
            );
          })()
        ):React.createElement("div",{style:{fontSize:12,color:C.text2}},"無資料（非交易日或盤中更新中）")
      ))
    ),
    showAI&&React.createElement(AIPanel,{stock,quote,inst,margin,onClose:()=>setShowAI(false)})
  );
}

// ── Ticker ─────────────────────────────────────────────────
function Ticker(){
  const stocks=["台積電 915.0 ▲3.5","聯發科 1,285 ▲8.0","鴻海 198.5 ▲1.0","緯穎 1,235 ▲3.0","漢翔 68.9 ▲1.4","日月光 156.5 ▼0.5","廣達 325 ▲6.5"];
  return React.createElement("div",{style:{background:C.bg3,borderBottom:`1px solid ${C.border}`,overflow:"hidden",height:28}},
    React.createElement("div",{style:{display:"flex",gap:48,animation:"ticker 30s linear infinite",whiteSpace:"nowrap",height:"100%",alignItems:"center",paddingLeft:16}},
      [...stocks,...stocks].map((s,i)=>React.createElement("span",{key:i,style:{fontSize:11,fontFamily:"IBM Plex Mono",color:s.includes("▲")?C.green:C.red,letterSpacing:"0.05em"}},s))
    )
  );
}

// ── App ────────────────────────────────────────────────────
function App(){
  const [tab,setTab]             = React.useState("chart");
  const [selStock,setStock]      = React.useState(DEFAULT_WATCHLIST[0]);
  const [watchlist,setWatchlist] = React.useState(DEFAULT_WATCHLIST);
  const [watchInput,setWInput]   = React.useState("");

  const addStock=()=>{
    const code=watchInput.trim();
    if(!code||watchlist.find(s=>s.code===code)) return;
    const ns={code,name:code,theme:"自選"};
    setWatchlist(prev=>[...prev,ns]);
    setStock(ns);
    setWInput("");
  };

  const navBtn=(id,label)=>React.createElement("button",{
    className:"btn-nav",onClick:()=>setTab(id),
    style:{background:tab===id?C.accentDim:"none",border:`1px solid ${tab===id?C.accent+"55":"transparent"}`,borderRadius:4,padding:"5px 16px",color:tab===id?C.accent:C.text2,fontSize:12,cursor:"pointer",fontFamily:"IBM Plex Mono",transition:"all 0.15s"}
  },label);

  return React.createElement("div",{style:{minHeight:"100vh",background:C.bg0,color:C.text0,fontFamily:"IBM Plex Mono"}},
    // header
    React.createElement("header",{style:{background:C.bg1,borderBottom:`1px solid ${C.border}`,padding:"0 24px",display:"flex",alignItems:"center",justifyContent:"space-between",height:52}},
      React.createElement("div",{style:{display:"flex",alignItems:"center",gap:24}},
        React.createElement("div",{style:{display:"flex",alignItems:"center",gap:10}},
          React.createElement("div",{style:{width:3,height:24,background:C.accent,borderRadius:2}}),
          React.createElement("span",{style:{fontSize:15,fontWeight:700,letterSpacing:"0.08em"}},"TWSTOCK"),
          React.createElement("span",{style:{background:C.greenDim,border:`1px solid ${C.green}44`,borderRadius:3,padding:"1px 7px",fontSize:9,color:C.green}},"LIVE")
        ),
        React.createElement("nav",{style:{display:"flex",gap:4}},
          navBtn("chart","股票分析"),
          navBtn("themes","熱門題材")
        )
      ),
      React.createElement("div",{style:{fontSize:10,color:C.text2}},"Fugle API · 證交所 OpenData")
    ),
    React.createElement(Ticker),
    // main
    React.createElement("main",{style:{padding:24,display:"grid",gridTemplateColumns:"200px 1fr",gap:16}},
      // sidebar
      React.createElement("div",{style:{background:C.bg1,border:`1px solid ${C.border}`,borderRadius:8,overflow:"hidden",alignSelf:"start"}},
        React.createElement("div",{style:{padding:"12px 16px",borderBottom:`1px solid ${C.border}`,fontSize:11,color:C.text2}},"▍ 自選股"),
        watchlist.map((s,i)=>React.createElement("div",{key:i,className:"row-hover",onClick:()=>setStock(s),
          style:{padding:"10px 14px",borderBottom:`1px solid ${C.border}`,background:selStock.code===s.code?C.bg3:"transparent",borderLeft:selStock.code===s.code?`3px solid ${C.accent}`:"3px solid transparent",transition:"all 0.15s"}},
          React.createElement("div",{style:{fontSize:12,fontWeight:700,color:C.text0}},s.code),
          React.createElement("div",{style:{fontSize:11,color:C.text2,marginTop:1}},s.name),
          React.createElement("div",{style:{fontSize:10,color:C.blue,marginTop:1}},s.theme)
        )),
        React.createElement("div",{style:{padding:"10px 12px",borderTop:`1px solid ${C.border}`}},
          React.createElement("div",{style:{display:"flex",gap:6}},
            React.createElement("input",{value:watchInput,onChange:e=>setWInput(e.target.value),onKeyDown:e=>e.key==="Enter"&&addStock(),placeholder:"輸入股號",
              style:{flex:1,background:C.bg3,border:`1px solid ${C.border}`,borderRadius:4,padding:"5px 8px",color:C.text0,fontSize:11,fontFamily:"IBM Plex Mono",outline:"none"}}),
            React.createElement("button",{onClick:addStock,style:{background:C.accent,border:"none",borderRadius:4,padding:"5px 10px",color:"#000",fontWeight:700,fontSize:11,cursor:"pointer"}},"+")
          )
        )
      ),
      // content
      React.createElement("div",{key:tab+selStock.code},
        tab==="chart"&&React.createElement(StockDetail,{stock:selStock}),
        tab==="themes"&&React.createElement("div",{style:{animation:"fadeIn 0.3s ease"}},
          React.createElement("div",{style:{fontSize:11,color:C.text2,marginBottom:16}},"▍ 熱門題材 · 點擊加入自選股"),
          React.createElement("div",{style:{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:14}},
            HOT_THEMES.map((t,i)=>React.createElement("div",{key:i,
              style:{background:C.bg1,border:`1px solid ${C.border}`,borderRadius:8,padding:18,cursor:"pointer",transition:"all 0.2s"},
              onMouseEnter:e=>{e.currentTarget.style.borderColor=C.accent+"66";},
              onMouseLeave:e=>{e.currentTarget.style.borderColor=C.border;}},
              React.createElement("div",{style:{fontSize:14,fontWeight:700,marginBottom:12}},t.name),
              React.createElement("div",{style:{display:"flex",flexDirection:"column",gap:6}},
                t.stocks.map((code,j)=>React.createElement("div",{key:j,className:"row-hover",
                  onClick:()=>{
                    const ns=watchlist.find(s=>s.code===code)||{code,name:code,theme:t.name};
                    if(!watchlist.find(s=>s.code===code)) setWatchlist(prev=>[...prev,ns]);
                    setStock(ns);setTab("chart");
                  },
                  style:{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"6px 10px",background:C.bg3,borderRadius:5,transition:"background 0.15s"}},
                  React.createElement("span",{style:{fontSize:12,fontFamily:"IBM Plex Mono"}},code),
                  React.createElement("span",{style:{fontSize:10,color:C.accent}},"+ 加入 →")
                ))
              )
            ))
          )
        )
      )
    )
  );
}

const root = ReactDOM.createRoot(document.getElementById("root"));
root.render(React.createElement(App));
</script>
</body>
</html>
